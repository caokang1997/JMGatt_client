.auto-ranging-container {
    margin-top: 14rpx;
    min-height: 600rpx;
    position: relative;
    width: 100%
}

.auto-ranging-bg-container {
    z-index: 99999
}

.auto-ranging-bg-container,.ranging-container {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 100%;
    left: 24rpx;
    position: absolute;
    right: 24rpx
}

.ranging-container {
    z-index: 100001
}

.auto-ranging-bg {
    width: 100%
}

.auto-ranging {
    position: absolute;
    top: 180rpx;
    width: 100%
}

.no-sensing-container {
    -webkit-align-items: center;
    align-items: center;
    height: 345rpx;
    left: 24rpx;
    right: 24rpx
}

.auto-ranging-card,.no-sensing-container {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    position: absolute
}

.auto-ranging-card {
    background-color: hsla(0,0%,100%,.3);
    border-radius: 16rpx;
    height: -webkit-fit-content;
    height: fit-content;
    -webkit-justify-content: flex-start;
    justify-content: flex-start;
    margin-left: 48rpx;
    margin-top: 88rpx;
    padding: 10rpx 20rpx;
    width: -webkit-fit-content;
    width: fit-content;
    z-index: 100002
}

.auto-ranging-card .row-container {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column
}

.auto-ranging-card .row-container .row-title {
    color: #000;
    font-size: 24rpx;
    opacity: .6
}

.auto-ranging-card .row-container .row-value {
    color: #724ffd;
    font-size: 24rpx
}

.whole-container1 {
    z-index: 99999
}

.whole-container,.whole-container1 {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 100%;
    position: absolute;
    width: 100%
}

.whole-container {
    z-index: 100003
}

.whole-container-center {
    position: relative;
    width: 600rpx
}

.tip-for-show {
    background-color: rgba(0,0,0,.2);
    border-radius: 20rpx;
    color: #fff;
    font-size: 20rpx;
    height: 40rpx;
    line-height: 40rpx;
    margin-top: 32rpx;
    text-align: center;
    width: 320rpx
}

.angle-pos {
    height: 60rpx;
    margin-left: 297rpx;
    margin-top: 146rpx;
    position: absolute;
    width: 80rpx
}

.angle-pos-txt {
    color: #000;
    font-size: 24rpx;
    margin-left: 385rpx;
    margin-top: 131rpx;
    opacity: .6;
    position: absolute
}

.human-img {
    height: 120rpx;
    margin-left: 241rpx;
    position: absolute;
    width: 120rpx
}

.current-distance-desc {
    color: #724ffd;
    font-size: 24rpx;
    margin-left: 5rpx;
    position: absolute
}
