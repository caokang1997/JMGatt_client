<swiper autoplay="{{false}}" bindchange="swiperChange" circular="true" class="swiper-block" current="0" indicatorActiveColor="#333" indicatorColor="#8a8a8a" indicatorDots="{{false}}" interval="5000" nextMargin="190rpx" previousMargin="190rpx">
    <swiper-item class="swiper-item " wx:for="{{imgUrls}}">
        <image class="slide-image {{currentIndex==index?'active':'common'}}" mode="aspectFill" src="{{item}}"></image>
    </swiper-item>
</swiper>
<view class="dots-box own-class">
    <view class="dots {{currentIndex==index?'bg-333':''}}" wx:for="{{imgUrls}}"></view>
</view>
