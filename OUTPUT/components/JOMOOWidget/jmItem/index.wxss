.rect {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 32rpx;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 134rpx;
    -webkit-justify-content: center;
    justify-content: center;
    width: 120rpx
}

.icon {
    background-color: #f1f1f1
}

.icon,.icon-on {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 24rpx;
    display: -webkit-flex;
    display: flex;
    height: 88rpx;
    -webkit-justify-content: center;
    justify-content: center;
    width: 88rpx
}

.icon-on {
    background-color: var(--primary-color)
}

.image {
    height: 48rpx;
    width: 48rpx
}

.text {
    color: #000;
    opacity: .6
}

.text,.text-on {
    font-size: 24rpx;
    margin-top: 16rpx
}

.text-on {
    color: #724ffd
}
