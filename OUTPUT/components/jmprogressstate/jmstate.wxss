.main {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    height: 480rpx;
    -webkit-justify-content: center;
    justify-content: center;
    position: relative;
    width: 100vw
}

.bg-disk-canvas {
    height: 480rpx;
    margin-top: 40rpx;
    position: absolute;
    width: 480rpx
}

.page {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 100%;
    -webkit-justify-content: center;
    justify-content: center;
    left: 0;
    position: absolute;
    top: 0;
    width: 100%
}

.title {
    color: #724ffd;
    font-size: 32rpx;
    font-weight: 500;
    margin-top: 80rpx
}

.center_value {
    color: rgba(0,0,0,.9);
    font-size: 90rpx;
    font-weight: 500
}

.bottom_txt {
    color: rgba(0,0,0,.6);
    font-size: 32rpx;
    font-weight: 400;
    margin-top: 64rpx
}
