.div-main {
    background-color: #fff;
    border-radius: 32rpx;
    margin-bottom: 24rpx;
    padding-bottom: 8rpx;
    padding-top: 8rpx
}

.div-private-custom-2 {
    grid-template-columns: auto auto;
    padding: 40rpx 106rpx
}

.div-private-custom-2,.div-private-custom-3 {
    grid-row-gap: 40rpx;
    box-sizing: border-box;
    display: grid;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    width: 100%
}

.div-private-custom-3 {
    grid-template-columns: auto auto auto;
    padding: 40rpx 56rpx
}

.div-private-custom-4 {
    grid-row-gap: 40rpx;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: auto auto auto auto;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    padding: 40rpx 28rpx;
    width: 100%
}

.div-expand {
    height: 80rpx
}

.div-expand,.div-view-expand {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    -webkit-justify-content: center;
    justify-content: center
}

.div-view-expand {
    height: 100%;
    padding-left: 20rpx;
    padding-right: 20rpx
}

.div-expand .arrow,.div-expand .arrow-rotated {
    height: 16rpx;
    margin-right: 4rpx;
    width: 22rpx
}

.div-expand .arrow-rotated {
    -webkit-transform: rotate(180deg);
    transform: rotate(180deg)
}

.div-expand .title {
    color: #000;
    font-size: 24rpx;
    font-weight: 600;
    opacity: .6
}

.div-slot {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column
}

.div-main-custom-setting {
    -webkit-align-items: center;
    align-items: center;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 80rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    padding-left: 40rpx;
    padding-right: 40rpx;
    width: 100%
}

.div-main-custom-setting-title {
    color: #000;
    font-size: 28rpx;
    opacity: .6
}

.div-main-custom-setting-right-block {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    -webkit-justify-content: flex-end;
    justify-content: flex-end
}

.div-main-custom-setting-right-title {
    color: #000;
    font-size: 28rpx;
    opacity: .6
}

.div-main-custom-setting-divider {
    background-color: #eaeafb;
    box-sizing: border-box;
    height: 1rpx;
    margin-left: 40rpx;
    margin-right: 40rpx;
    width: calc(100%-80rpx)
}

.custom-button-wrapper {
    display: block;
    position: relative
}

.period-badge,.period-badge-large {
    -webkit-align-items: center;
    align-items: center;
    background-color: #ff6085;
    border-radius: 0 24rpx 0 24rpx;
    display: -webkit-flex;
    display: flex;
    height: 30rpx;
    -webkit-justify-content: center;
    justify-content: center;
    padding: 0 10rpx;
    pointer-events: none;
    position: absolute;
    z-index: 10
}

.period-badge {
    right: 13rpx;
    top: 0
}

.period-badge-large {
    left: 60rpx;
    top: 41rpx
}

.period-badge-text {
    color: #fff;
    font-size: 14rpx;
    font-weight: 400;
    white-space: nowrap
}
