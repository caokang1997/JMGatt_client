.main {
    -webkit-align-items: center;
    align-items: center;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 100%;
    -webkit-justify-content: center;
    justify-content: center
}

.div-value,.main {
    display: -webkit-flex;
    display: flex
}

.div-value {
    -webkit-flex-direction: row;
    flex-direction: row
}

.text-value {
    font-size: 48rpx;
    font-weight: 500
}

.text-unit {
    margin-left: 8rpx
}

.text-title,.text-unit {
    font-size: 24rpx;
    opacity: .6
}

.text-title {
    margin-top: 8rpx
}
