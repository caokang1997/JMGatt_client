.ai-voice-setting-row-divider {
    background-color: #000;
    height: 1rpx;
    width: 100%
}

.ai-voice-setting-column-divider {
    background-color: #000;
    height: 100%;
    width: 1rpx
}

.ai-voice-setting-round {
    -webkit-flex-direction: column;
    flex-direction: column
}

.ai-voice-setting-container,.ai-voice-setting-round {
    background-color: #eef0f8;
    border: 1rpx solid #000;
    border-radius: 16rpx;
    display: -webkit-flex;
    display: flex;
    width: 100%
}

.ai-voice-setting-container {
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    position: relative
}

.ai-voice-setting-container::after {
    background-color: #000;
    content: "";
    height: 100%;
    left: 50%;
    position: absolute;
    top: 0;
    width: 1rpx
}

.ai-voice-setting-item {
    border-top: 1rpx solid #000;
    box-sizing: border-box;
    color: #000;
    font-size: 28rpx;
    height: 80rpx;
    line-height: 80rpx;
    padding-left: 40rpx;
    width: 50%
}

.ai-voice-setting-item:nth-child(-n+2) {
    border-top: none
}

.ai-voice-setting-tab-title {
    color: #000;
    font-size: 32rpx;
    height: 96rpx;
    line-height: 96rpx;
    text-align: center;
    width: 100%
}

.ai-voice-setting-tab-line {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 80rpx;
    width: 100%
}

.ai-voice-setting-tab-cell {
    color: #000;
    -webkit-flex: 1;
    flex: 1;
    font-size: 28rpx;
    height: 80rpx;
    line-height: 80rpx;
    padding-left: 40rpx
}

.ia_voice_setting_dlg_container {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    padding-left: 30rpx;
    padding-right: 30rpx;
    width: calc(100%-60rpx)
}

.ia_voice_setting_dlg_title_2 {
    color: #000;
    font-size: 32rpx;
    font-weight: 500
}

.ia_voice_setting_dlg_content_1 {
    color: #000;
    font-size: 28rpx;
    font-weight: 400;
    opacity: .6
}

.ia_voice_setting_dlg_desc_container {
    width: 285rpx
}

.ia_voice_setting_dlg_desc_container,.ia_voice_setting_dlg_desc_container_1 {
    background-color: #eaeafb;
    border-radius: 23rpx;
    color: #724ffd;
    font-size: 24rpx;
    height: 46rpx;
    line-height: 46rpx;
    padding-left: 20rpx;
    padding-right: 20rpx
}

.ia_voice_setting_dlg_desc_container_1 {
    width: 600rpx
}

.ia_voice_setting_dlg_title_container {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 72rpx;
    margin-top: 20rpx;
    width: 100%
}

.ia_voice_setting_dlg_title {
    font-size: 40rpx;
    font-weight: 500;
    margin-left: 24rpx
}

.photo-back {
    display: -webkit-flex;
    display: flex;
    height: 72rpx;
    width: 72rpx
}
