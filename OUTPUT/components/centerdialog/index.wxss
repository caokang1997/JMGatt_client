.dialog-mask {
    -webkit-align-items: center;
    align-items: center;
    background: rgba(0,0,0,.6);
    bottom: 0;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center;
    left: 0;
    opacity: 0;
    position: fixed;
    right: 0;
    top: 0;
    transition: all .3s;
    visibility: hidden
}

.dialog-mask.show {
    opacity: 1;
    visibility: visible
}

.dialog-container {
    background: #fff;
    border-radius: 24rpx;
    max-width: 600rpx;
    opacity: 0;
    overflow: hidden;
    transition: opacity .3s;
    width: 80%
}

.dialog-mask.show .dialog-container {
    opacity: 1
}

.dialog-header {
    border-bottom: 1rpx solid #eee;
    padding: 32rpx;
    text-align: center
}

.dialog-title {
    color: #333;
    font-size: 32rpx;
    font-weight: 500
}

.dialog-content {
    max-height: 60vh;
    overflow-y: auto
}

.dialog-footer {
    border-top: 1rpx solid #eee;
    gap: 24rpx;
    padding: 32rpx
}

.dialog-btn,.dialog-footer {
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center
}

.dialog-btn {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 44rpx;
    -webkit-flex: 1;
    flex: 1;
    font-size: 32rpx;
    font-weight: 500;
    height: 88rpx;
    margin: 0
}

.dialog-btn.cancel {
    background: #f5f5f5;
    color: #666
}

.dialog-btn.confirm {
    background: #724ffd;
    color: #fff
}
