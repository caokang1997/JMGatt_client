<view class="xmswitchbar-main">
    <view class="rect_all {{isRoundRect?'rect-round':'rect'}} {{icon&&icon.length>0?'has-icon':''}}">
        <view bind:tap="onClickItem" class="left-container">
            <image class="icon" mode="aspectFit" src="{{icon}}" style="opacity:{{enable?1:0.4}};" wx:if="{{icon&&icon.length>0}}"></image>
            <view class="left">
                <text class="text" style="opacity:{{enable?1:0.4}};" wx:if="{{!hasTip}}">{{titleString}}</text>
                <view bind:tap="onClickTitleTip" class="title-container1" wx:if="{{hasTip}}">
                    <text class="text" style="opacity:{{enable?1:0.4}};">{{titleString}}</text>
                    <image class="title-tip" src="https://muyun.jomoo.cn/jomoo/organic/muyun/wechat/images/photo/ic_tip.png"></image>
                </view>
                <view class="detail" style="opacity:{{enable?1:0.4}};" wx:if="{{detail.length>0}}">{{detailString}}</view>
            </view>
        </view>
        <JSwitch bind:onchecked="onSwitchChange" enable="{{enable}}" isChecked="{{checked}}" style="opacity:{{enable?1:0.6}};" wx:if="{{isExecute}}"></JSwitch>
        <view bind:tap="onClickState" class="{{checked?'content_checked':'content'}}" wx:else>{{checked?'已开启':'已关闭'}}</view>
    </view>
    <view class="divider" wx:if="{{withdivider}}"></view>
</view>
