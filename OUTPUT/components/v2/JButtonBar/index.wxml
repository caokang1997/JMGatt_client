<view bindtap="onClickButton" class="{{isSmallIconMode?'rect-small':on?'rect-on':'rect'}}" style="{{enable?'opacity:1':'opacity:0.4'}}">
    <block wx:if="{{isSmallIconMode}}">
        <image class="image-small" src="{{displayIcon}}"></image>
        <view class="div-info-small">
            <text class="text-small">{{title}}</text>
            <text class="text-state-small" wx:if="{{showContent&&content&&content.length>0}}">{{content}}</text>
        </view>
    </block>
    <block wx:else>
        <view animation="{{buttonAnimation}}" class="{{on?'icon-on':'icon'}}" style="{{on?'background-color: '+colorOn:'background-color: '+colorOff}}">
            <image class="image" src="{{displayIcon}}"></image>
        </view>
        <view class="div-info">
            <text class="{{on?'text-on':'text'}}">{{title}}</text>
            <text class="text-state" wx:if="{{showContent}}">{{content}}</text>
        </view>
    </block>
</view>
