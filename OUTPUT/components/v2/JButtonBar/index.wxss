.rect,.rect-on {
    padding-left: 32rpx
}

.rect,.rect-on,.rect-small {
    -webkit-align-items: center;
    align-items: center;
    background-color: #fff;
    border-radius: 32rpx;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 168rpx
}

.rect-small {
    box-sizing: border-box;
    padding-left: 24rpx;
    padding-right: 24rpx
}

.image {
    height: 48rpx;
    width: 48rpx
}

.image-small {
    height: 60rpx;
    width: 60rpx
}

.div-info,.div-info-small {
    display: -webkit-flex;
    display: flex;
    -webkit-flex: 1;
    flex: 1;
    -webkit-flex-direction: column;
    flex-direction: column;
    margin-left: 16rpx
}

.div-info-small {
    -webkit-justify-content: center;
    justify-content: center
}

.text,.text-on {
    color: #000;
    font-size: 32rpx;
    font-weight: 500;
    opacity: .9
}

.text-state {
    color: #000;
    font-size: 24rpx;
    margin-top: 8rpx;
    opacity: .6
}

.text-small {
    color: rgba(0,0,0,.9);
    font-size: 32rpx;
    font-weight: 500;
    line-height: 40rpx
}

.text-state-small {
    color: rgba(0,0,0,.6);
    font-size: 28rpx;
    font-weight: 400;
    line-height: 32rpx;
    margin-top: 4rpx
}

.enter-small {
    height: 48rpx;
    width: 24rpx
}

.text-state-on {
    color: #000;
    font-size: 24rpx;
    font-weight: 600;
    margin-top: 8rpx;
    opacity: .6
}

.icon {
    background-color: #f1f1f1
}

.icon,.icon-on {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 24rpx;
    display: -webkit-flex;
    display: flex;
    height: 88rpx;
    -webkit-justify-content: center;
    justify-content: center;
    width: 88rpx
}

.icon-on {
    background-color: var(--primary-color)
}
