<view bind:tap="OnClickMask" class="dialog-mask {{showDialog?'dialog-show':'dialog-hide'}}"></view>
<view class="dialog-container {{showDialog?'dialog-show':'dialog-hide'}}">
    <view class="dialog-content">
        <scroll-view scrollY class="dialog-body">
            <slot></slot>
        </scroll-view>
    </view>
</view>
