<view bindtap="onClickButton" class="rect" style="{{enable?'opacity:1':'opacity:0.6'}}" wx:if="{{flexDirection=='column'}}">
    <view animation="{{buttonAnimation}}" class="{{on?'icon-on':'icon'}}" style="{{on?'background-color: '+colorOn:'background-color: '+colorOff}}">
        <image class="image" src="{{imageIcon}}"></image>
    </view>
    <text class="{{on?'text-on':'text'}}">{{title}}</text>
</view>
<view bindtap="onClickButton" class="rect-row" style="{{enable?'opacity:1':'opacity:0.6'}}" wx:else>
    <view animation="{{buttonAnimation}}" class="{{on?'icon-on':'icon'}}" style="{{on?'background-color: '+colorOn:'background-color: '+colorOff}}">
        <image class="image" src="{{imageIcon}}"></image>
    </view>
    <text class="{{on?'text-on':'text'}}">{{title}}</text>
</view>
