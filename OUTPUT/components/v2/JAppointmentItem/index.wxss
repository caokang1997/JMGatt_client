.card-wrapper {
    -webkit-align-items: center;
    align-items: center;
    background-color: #fff;
    border-radius: 32rpx;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 128rpx;
    margin-top: 24rpx;
    overflow: hidden;
    padding-left: 24rpx;
    padding-right: 24rpx
}

.card-wrapper.is-editing {
    -webkit-align-items: stretch;
    align-items: stretch;
    background-color: initial;
    padding-left: 0;
    padding-right: 0
}

.card-main {
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    -webkit-flex: 1;
    flex: 1;
    -webkit-flex-direction: column;
    flex-direction: column;
    -webkit-justify-content: center;
    justify-content: center
}

.card-wrapper.is-editing .card-main {
    background-color: #fff;
    padding-left: 24rpx;
    padding-right: 24rpx
}

.card-right,.delete-btn {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center
}

.delete-btn {
    background-color: #ff4d3a;
    width: 128rpx
}

.trash {
    height: 48rpx;
    position: relative;
    width: 40rpx
}

.trash-handle {
    top: 0;
    width: 18rpx
}

.trash-handle,.trash-lid {
    background-color: #fff;
    border-radius: 3rpx;
    height: 6rpx;
    left: 50%;
    position: absolute;
    -webkit-transform: translateX(-50%);
    transform: translateX(-50%)
}

.trash-lid {
    top: 8rpx;
    width: 40rpx
}

.trash-page {
    border: 4rpx solid #fff;
    border-bottom-left-radius: 6rpx;
    border-bottom-right-radius: 6rpx;
    border-top: 0;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 30rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    left: 50%;
    padding-left: 5rpx;
    padding-right: 5rpx;
    padding-top: 6rpx;
    position: absolute;
    top: 16rpx;
    -webkit-transform: translateX(-50%);
    transform: translateX(-50%);
    width: 34rpx
}

.trash-line {
    background-color: #fff;
    border-radius: 2rpx;
    height: 16rpx;
    width: 4rpx
}

.time {
    color: #000;
    font-size: 40rpx;
    font-weight: 500;
    line-height: 40rpx
}

.sub-row {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    margin-top: 8rpx
}

.sub-text {
    color: rgba(0,0,0,.6);
    font-size: 28rpx;
    font-weight: 400;
    line-height: 32rpx
}

.arrow {
    height: 24rpx;
    margin-left: 8rpx;
    width: 24rpx
}
