.main-container {
    -webkit-flex-direction: column;
    flex-direction: column;
    padding: 16rpx 44rpx
}

.div-title,.main-container {
    display: -webkit-flex;
    display: flex
}

.div-title {
    -webkit-align-items: center;
    align-items: center;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 128rpx;
    width: 100%
}

.div-title-left {
    display: -webkit-flex;
    display: flex;
    -webkit-flex: 1;
    flex: 1;
    -webkit-flex-direction: column;
    flex-direction: column
}

.div-title-left-value {
    color: #724ffd;
    font-size: 28rpx;
    font-weight: 400
}

.title {
    color: #333;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    font-size: 40rpx;
    -webkit-justify-content: center;
    justify-content: center;
    width: 100%
}

.div-nav {
    background-color: #efebff;
    border-radius: 16rpx;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 80rpx;
    margin-left: 36rpx;
    width: 610rpx
}

.div-nav,.div-nav-selected {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center
}

.div-nav-selected {
    color: #724ffd;
    font-size: 16px;
    font-weight: 500;
    height: 100%;
    text-align: center;
    width: 288rpx
}

.div-nav-unSelected {
    color: #666;
    font-size: 16px;
    font-weight: 500;
    height: 100%;
    text-align: center;
    width: 288rpx
}

.bottom,.div-nav-unSelected {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center
}

.bottom {
    -webkit-flex-direction: row;
    flex-direction: row;
    margin-bottom: 40rpx;
    margin-top: 40rpx;
    width: 100%
}

.button-high {
    background: #724ffd;
    color: #fff
}

.button,.button-high {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 24rpx;
    display: -webkit-flex;
    display: flex;
    -webkit-flex: 1;
    flex: 1;
    font-size: 34rpx;
    height: 96rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin-left: 32rpx;
    margin-right: 32rpx
}

.button {
    background-color: #fff;
    border: 1px solid #724ffd;
    color: #724ffd
}
