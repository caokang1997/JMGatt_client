.bath_voice_dlg_container {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    padding-left: 30rpx;
    padding-right: 30rpx;
    width: calc(100%-60rpx)
}

.bath_voice_dlg_title_container {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 72rpx;
    margin-top: 20rpx;
    width: 100%
}

.bath_voice_dlg_title {
    font-size: 40rpx;
    font-weight: 500;
    margin-left: 24rpx
}

.bath_voice_dlg_title_2 {
    color: #000;
    font-size: 32rpx;
    font-weight: 500
}

.bath_voice_dlg_content_line {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row
}

.bath_voice_dlg_dot {
    color: #000;
    font-size: 28rpx;
    margin-right: 8rpx
}

.bath_voice_dlg_label {
    color: #000;
    font-size: 28rpx;
    font-weight: 400;
    margin-right: 12rpx
}

.bath_voice_dlg_content_1 {
    color: #000;
    font-size: 28rpx;
    font-weight: 400;
    opacity: .6
}

.bath_voice_dlg_desc_container,.bath_voice_dlg_desc_container_1 {
    -webkit-align-self: flex-start;
    align-self: flex-start;
    background-color: #eaeafb;
    border-radius: 23rpx;
    color: #724ffd;
    font-size: 24rpx;
    height: 46rpx;
    line-height: 46rpx;
    padding-left: 20rpx;
    padding-right: 20rpx
}

.bath-voice-setting-container {
    background-color: #eef0f8;
    border: 1rpx solid #000;
    border-radius: 16rpx;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    position: relative;
    width: 100%
}

.bath-voice-setting-container::after {
    background-color: #000;
    content: "";
    height: 100%;
    left: 50%;
    position: absolute;
    top: 0;
    width: 1rpx
}

.bath-voice-setting-item {
    border-top: 1rpx solid #000;
    box-sizing: border-box;
    color: #000;
    font-size: 28rpx;
    height: 80rpx;
    line-height: 80rpx;
    padding-left: 40rpx;
    width: 50%
}

.bath-voice-setting-item:nth-child(-n+2) {
    border-top: none
}

.photo-back {
    display: -webkit-flex;
    display: flex;
    height: 72rpx;
    width: 72rpx
}
