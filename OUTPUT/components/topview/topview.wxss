.main,.navigation-container {
    position: relative;
    width: 100vw
}

.main {
    box-sizing: border-box;
    height: 744rpx
}

.div-toilet {
    margin-left: 72rpx;
    margin-top: 48rpx
}

.bg-toilet,.div-toilet {
    height: 624rpx;
    position: absolute;
    width: 356rpx
}

.bg-toilet-seat {
    height: 104rpx;
    margin-left: 80rpx;
    margin-top: 335rpx;
    position: absolute;
    width: 276rpx
}

.div-jmtemp {
    height: 612rpx;
    position: absolute;
    right: 18rpx;
    top: 48rpx;
    width: 216rpx
}

.div-temp {
    -webkit-flex-direction: column;
    flex-direction: column;
    -webkit-justify-content: center;
    justify-content: center;
    left: 344rpx;
    top: 190rpx
}

.div-error,.div-temp {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    position: absolute
}

.div-error {
    background-color: #ffefe9;
    border-radius: 80rpx;
    bottom: 32rpx;
    box-sizing: border-box;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 80rpx;
    left: 88rpx;
    right: 88rpx;
    width: cal(100% - 176rpx);
    z-index: 9999
}

.img-tip {
    height: 48rpx;
    margin-left: 32rpx;
    margin-right: 16rpx;
    width: 48rpx
}

.img-arrow {
    height: 48rpx;
    margin-right: 32rpx;
    width: 24rpx
}

.tip-text {
    color: #fb7f4a;
    -webkit-flex: 1;
    flex: 1;
    font-size: 28rpx
}

.text-temp-value {
    font-size: 56rpx;
    font-weight: 500
}

.text-temp-title {
    font-size: 32rpx;
    font-weight: 400;
    opacity: .4
}

.bg {
    position: absolute;
    width: 100vw
}
