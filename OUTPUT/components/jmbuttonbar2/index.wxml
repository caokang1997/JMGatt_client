<view bindtap="onClickButton" class="{{on?'rect-on':'rect'}}" style="{{enable?'opacity:1':'opacity:0.6'}}">
    <view class="{{on?'icon-on':'icon'}}" style="{{on?'background-color: '+colorOn:'background-color: '+colorOff}}">
        <image class="image" src="{{imageIcon}}"></image>
    </view>
    <div class="div-info">
        <text class="{{on?'text-on':'text'}}">{{title}}</text>
        <text class="{{on?'text-state-on':'text-state'}}" wx:if="{{showContent}}">{{on?'开启':'关闭'}}</text>
    </div>
</view>
