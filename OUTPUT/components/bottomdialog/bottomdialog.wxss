.background_screen {
    background: #000;
    color: #fff;
    height: 100%;
    opacity: .2;
    top: 0;
    z-index: 1000
}

.attr_box,.background_screen {
    left: 0;
    overflow: hidden;
    position: fixed;
    width: 100%
}

.attr_box {
    background: #fff;
    border-radius: 32rpx 32rpx 0rpx 0rpx;
    bottom: 0;
    box-sizing: border-box;
    height: auto;
    opacity: 1;
    z-index: 2000
}

.dialog-box {
    height: 100%;
    min-height: 144rpx;
    width: 100%
}

.dialog-head {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    height: 60rpx;
    -webkit-justify-content: flex-end;
    justify-content: flex-end
}

.dialog-title {
    color: rgba(0,0,0,.9);
    font-family: PingFang SC;
    font-size: 32rpx;
    font-weight: 700;
    -webkit-justify-content: center;
    justify-content: center;
    width: 80%
}

.close2ImgBox,.dialog-title {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    height: 100%
}

.close2ImgBox {
    width: 10%
}

.close2Img {
    height: 44rpx;
    width: 44rpx
}

.dialog-content {
    box-sizing: border-box;
    height: calc(100% - 60rpx);
    padding: 40rpx 0
}

.select-box {
    -webkit-flex-direction: column;
    flex-direction: column;
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    -webkit-justify-content: start;
    justify-content: start;
    padding: 0 0 30rpx 0rpx
}

.select-box,.select-item {
    -webkit-align-items: center;
    align-items: center;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center
}

.select-item {
    background: #f6f5f8;
    border-radius: 40rpx;
    color: #151521;
    font-family: PingFang SC;
    font-size: 32rpx;
    font-weight: 400;
    height: 88rpx;
    line-height: 68rpx;
    margin-bottom: 32rpx;
    opacity: 1;
    text-align: center;
    width: 80%
}

.selectedItem {
    background: #ff5050;
    border: 1px solid #ff5050;
    color: #fff
}

.btnBox {
    width: 100%
}

.btn,.btnBox {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center
}

.btn {
    background: #ff3b3b;
    border: none;
    border-radius: 48rpx;
    bottom: 50rpx;
    color: #fff;
    font-family: PingFang SC;
    font-size: 32rpx;
    font-weight: 500;
    height: 88rpx;
    left: 50%;
    opacity: 1;
    outline: none;
    position: absolute;
    -webkit-transform: translate(-50%,0);
    transform: translate(-50%,0);
    width: 90%!important
}
