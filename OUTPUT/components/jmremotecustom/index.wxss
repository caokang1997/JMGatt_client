.rect {
    background-color: #fff;
    border-radius: 32rpx;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 584rpx;
    margin-bottom: 32rpx;
    padding-left: 24rpx;
    padding-right: 24rpx
}

.rect,.top-container {
    -webkit-align-items: center;
    align-items: center;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    width: 100%
}

.top-container {
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 160rpx;
    -webkit-justify-content: flex-start;
    justify-content: flex-start
}

.photo {
    height: 88rpx;
    width: 88rpx
}

.top-head-title-container {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row
}

.text {
    color: #000;
    font-size: 32rpx;
    font-weight: 400;
    opacity: 1
}

.title2 {
    background-color: #724ffd;
    border-radius: 18rpx;
    color: #fff;
    font-size: 24rpx;
    height: 36rpx;
    line-height: 36rpx;
    margin-left: 5rpx;
    margin-top: 8rpx;
    padding-left: 10rpx;
    padding-right: 10rpx;
    text-align: center
}

.subtitle1 {
    color: #000;
    font-size: 28rpx;
    font-weight: 400;
    opacity: .6
}

.subtitle2 {
    color: #724ffd;
    font-size: 28rpx;
    font-weight: 500;
    margin-left: 4rpx
}

.top-head {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    margin-left: 16rpx
}

.line {
    background-color: #000;
    height: 2rpx;
    opacity: .1;
    width: 100%
}

.custom-desc-container {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 80rpx;
    margin-top: 16rpx;
    width: 100%
}

.custom-desc {
    color: #000;
    font-size: 28rpx;
    opacity: .9
}

.switch {
    color: #724ffd;
    height: 44rpx;
    width: 72rpx
}

.page-page {
    box-sizing: border-box;
    width: 100%
}

.button-group {
    -webkit-column-gap: 30rpx;
    column-gap: 30rpx;
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    row-gap: 40rpx;
    width: 100%
}

.btn-card,.button-group {
    display: -webkit-flex;
    display: flex
}

.btn-card {
    -webkit-align-items: center;
    align-items: center;
    box-sizing: border-box;
    -webkit-flex: none;
    flex: none;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 136rpx;
    -webkit-justify-content: center;
    justify-content: center;
    overflow: hidden;
    width: 132rpx
}

.logo-container {
    height: 88rpx;
    margin-bottom: 12rpx;
    position: relative;
    width: 88rpx
}

.btn-logo {
    display: block;
    height: 88rpx;
    width: 88rpx
}

.new-badge {
    bottom: 0;
    height: 36rpx;
    position: absolute;
    right: 0;
    width: 36rpx
}

.btn-title {
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: #000;
    display: -webkit-box;
    font-size: 24rpx;
    line-height: 1.2;
    max-width: 100%;
    opacity: .9;
    overflow: hidden;
    padding: 0 8rpx;
    text-align: center;
    word-break: break-all
}
